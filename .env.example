# Process settings. Copy to .env for development; set as real environment
# variables in deployment. Nothing here is required to *start*: the router
# boots with the demo route and refuses admin calls until ADMIN_TOKEN is set.

ENV=development                 # development | test | production
HOST=127.0.0.1                  # 0.0.0.0 inside a container
PORT=8080
LOG_LEVEL=INFO
ROUTER_CONFIG=router.yaml
DATABASE_URL=sqlite:///./router.db   # any SQLAlchemy URL; compose uses PostgreSQL
REQUEST_TIMEOUT_S=60
MAX_REQUEST_BYTES=1000000

# Required before POST /admin/* answers anything but 503.
ADMIN_TOKEN=

# Provider credentials, named by `api_key_env` in router.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
